
def criptografar(senha):
    senha_criptografada = ""

    for numero in senha:
        novo_numero = (int(numero) + 1) % 10
        senha_criptografada += str(novo_numero)

    return senha_criptografada


def descriptografar(senha):
    senha_original = ""

    for numero in senha:
        novo_numero = (int(numero) - 1) % 10
        senha_original += str(novo_numero)

    return senha_original


print("=== LABORATÓRIO DE SENHAS ===")
print("1 - Criptografar senha")
print("2 - Descriptografar senha")

opcao = input("Escolha uma opção: ")
senha = input("Digite uma senha numérica: ")

if not senha.isdigit():
    print("Erro: digite apenas números.")
elif opcao == "1":
    resultado = criptografar(senha)
    print("Senha criptografada:", resultado)
elif opcao == "2":
    resultado = descriptografar(senha)
    print("Senha original:", resultado)
else:
    print("Opção inválida.")
